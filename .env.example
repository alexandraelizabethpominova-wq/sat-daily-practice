# Optional overrides. Local development defaults to the same shared Supabase
# project used by the deployed SAT app, so signing in with the same account
# loads the same cloud data on localhost and GitHub Pages.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
